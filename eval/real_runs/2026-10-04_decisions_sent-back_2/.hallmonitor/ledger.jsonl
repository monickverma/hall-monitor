{"id": "D1", "text": "Changes to app/auth.py require a review by the security team before they are merged.", "source": "docs/security-policy.pdf \u00a72", "kind": "obligation", "recorded_at": "2026-10-04T02:23:30+00:00", "supersedes": null, "per_action": false}
{"id": "D2", "text": "Password comparison must remain constant-time.", "source": "docs/security-policy.pdf \u00a72", "kind": "obligation", "recorded_at": "2026-10-04T02:23:32+00:00", "supersedes": null, "per_action": true}
{"id": "D3", "text": "Services must use only the Python standard library; no third-party dependencies may be added.", "source": "docs/security-policy.pdf \u00a73", "kind": "limit", "recorded_at": "2026-10-04T02:23:35+00:00", "supersedes": null, "per_action": true}
{"id": "D4", "text": "New third-party dependencies require written approval from Platform Security before being added.", "source": "docs/security-policy.pdf \u00a73", "kind": "obligation", "recorded_at": "2026-10-04T02:23:37+00:00", "supersedes": "D3", "per_action": false}
{"id": "D5", "text": "Every behavior change must ship with a test that fails without the change.", "source": "docs/security-policy.pdf \u00a74", "kind": "obligation", "recorded_at": "2026-10-04T02:23:40+00:00", "supersedes": null, "per_action": false}
{"id": "D6", "text": "Tests that do not assert on the changed behavior do not count toward the testing requirement.", "source": "docs/security-policy.pdf \u00a74", "kind": "obligation", "recorded_at": "2026-10-04T02:23:42+00:00", "supersedes": null, "per_action": false}
