@@ -71,6 +71,27 @@ def _modern_truncate(text: str, max_length: int, word_boundary: bool, separator:
 
     Output delimiters may also occur in words; never strip or split emitted text.
     Post replacements retain the historical global dash-to-separator mapping.
+
+    Parameters
+    ----------
+    text:
+        Intermediate slug string using the internal ``'-'`` separator, produced
+        after filtering, transliteration and stopword removal.
+    max_length:
+        Maximum number of characters in the returned string, measured after
+        replacing the internal ``'-'`` separator with *separator*.  ``0`` or
+        negative means no limit.
+    word_boundary:
+        When ``True``, only cut on whole-token boundaries (no partial words).
+        Tokens that individually exceed *max_length* are skipped; if none fit,
+        the result may be empty.
+    separator:
+        Output delimiter to substitute for every internal ``'-'``.  The length
+        of this string is taken into account when computing the character budget.
+    save_order:
+        When ``True`` and *word_boundary* is also ``True``, stop accumulating
+        tokens the first time one would exceed the budget (preserve original
+        word order without skipping ahead).
     """
     if max_length <= 0:
         return text.replace(DEFAULT_SEPARATOR, separator)
